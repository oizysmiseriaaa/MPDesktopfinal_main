{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables core and desktop booking export permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DESKTOP/ManilaPrime" },
        { "path": "$DESKTOP/ManilaPrime/*" },
        { "path": "$DESKTOP/ManilaPrime/Bookings" },
        { "path": "$DESKTOP/ManilaPrime/Bookings/*" },
        { "path": "$DESKTOP/ManilaPrime/Quotations" },
        { "path": "$DESKTOP/ManilaPrime/Quotations/*" },
        { "path": "$DESKTOP/ManilaPrime/SOA" },
        { "path": "$DESKTOP/ManilaPrime/SOA/*" }
      ]
    }
  ]
}
