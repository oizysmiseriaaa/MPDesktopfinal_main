{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables core, booking image, and generated document save permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "fs:allow-mkdir",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DESKTOP/ManilaPrime" },
        { "path": "$DESKTOP/ManilaPrime/*" },
        { "path": "$DESKTOP/ManilaPrime/Bookings" },
        { "path": "$DESKTOP/ManilaPrime/Bookings/*" },
        { "path": "$DESKTOP/ManilaPrime/Quotations" },
        { "path": "$DESKTOP/ManilaPrime/Quotations/*" },
        { "path": "$DESKTOP/ManilaPrime/SOA" },
        { "path": "$DESKTOP/ManilaPrime/SOA/*" },
        { "path": "$DESKTOP/ManilaPrime/HostFlow" },
        { "path": "$DESKTOP/ManilaPrime/HostFlow/*" },
        { "path": "$DOCUMENT/HostFlow" },
        { "path": "$DOCUMENT/HostFlow/*" },
        { "path": "$DOCUMENT/HostFlow/Quotations" },
        { "path": "$DOCUMENT/HostFlow/Quotations/*" },
        { "path": "$DOCUMENT/HostFlow/Statements of Account" },
        { "path": "$DOCUMENT/HostFlow/Statements of Account/*" }
      ]
    }
  ]
}
